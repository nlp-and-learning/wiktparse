{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wiktionary page",
  "description": "One page of a Wiktionary as one JSONL line (wikt2jsonl). Sections form the tree of the page's headings 1:1 (template lines like pl {{synonimy}} one level below the last heading); translations stand next to senses, not linked to them yet.",
  "type": "object",
  "required": [
    "wiki",
    "title",
    "ns",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "wiki": {
      "type": "string",
      "description": "Wiktionary code: en, pl, zh_min_nan"
    },
    "title": {
      "type": "string"
    },
    "ns": {
      "type": "integer",
      "description": "Namespace number of the page"
    },
    "sections": {
      "type": "array",
      "description": "Language sections in page order",
      "items": {
        "$ref": "#/$defs/language"
      }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "required": [
        "language",
        "code",
        "native"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "description": "Language as written in the page (name, code or template)"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical code (wiktlangs.sqlite), null when not known"
        },
        "native": {
          "type": "boolean",
          "description": "The section is in the wiki's own language"
        },
        "text": {
          "type": "string",
          "description": "Raw wikitext before the first section"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "unknown_headings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Headings without an English section name yet"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "section",
        "kind",
        "heading",
        "level",
        "index",
        "text",
        "senses",
        "translations",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "section": {
          "type": [
            "string",
            "null"
          ],
          "description": "English name: Noun, Synonyms, Translations; null when not known"
        },
        "kind": {
          "enum": [
            "pos",
            "etymology",
            "relation",
            "section",
            null
          ],
          "description": "Part of speech, etymology, relation (synonyms...), other section; null when not known"
        },
        "heading": {
          "type": "string",
          "description": "Heading, template line or italic line as written"
        },
        "level": {
          "type": "integer",
          "description": "Heading level; template lines one below the last heading"
        },
        "template": {
          "type": "boolean",
          "description": "The section is a template line, not a heading"
        },
        "index": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Number of a numbered section (Etymology 2)"
        },
        "text": {
          "type": "string",
          "description": "Raw wikitext of the section without its subsections and senses"
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sense"
          }
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/translation"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "sense": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "1, 1.2 (from # and ##), or as written: 1.1, 1a"
        },
        "text": {
          "type": "string",
          "description": "Raw wikitext of the definition"
        }
      }
    },
    "translation": {
      "type": "object",
      "required": [
        "lang",
        "term",
        "sense"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical language code, null when not known"
        },
        "lang_written": {
          "type": "string",
          "description": "Language as written when it differs from lang"
        },
        "term": {
          "type": "string"
        },
        "sense": {
          "type": "string",
          "description": "Sense number given by the wiki (pl 1.1, fr/de table number, es a1), empty when none"
        }
      }
    }
  }
}
